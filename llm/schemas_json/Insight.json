          "title": "Bank Product"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "type"
      ],
      "title": "Action",
      "type": "object"
    },
    "Consequence": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "risk",
            "opportunity",
            "factor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "horizon": {
          "$ref": "#/$defs/Horizon"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "kind",
        "level",
        "horizon",
        "origin"

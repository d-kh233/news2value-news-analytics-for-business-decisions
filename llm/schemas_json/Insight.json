          "enum": [
            "action",
            "question",
            "scenario"
          ],
          "title": "Type",
          "type": "string"
        },
        "bank_product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,

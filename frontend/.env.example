# Скопируйте в .env и поменяйте при необходимости.
# Ключей LLM здесь быть не должно: фронтенд ходит только в наш бэкенд.

# true — данные берутся из src/mocks (копия data/mocks бэкенда), бэкенд не нужен.
# false — запросы идут на бэкенд http://127.0.0.1:8000 через прокси Vite (vite.config.ts).
VITE_USE_MOCKS=true

# Префикс запросов к бэкенду. Менять не нужно, пока фронт запускается через npm run dev.
VITE_API_BASE_URL=/api

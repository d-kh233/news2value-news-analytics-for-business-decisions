# Приложение
APP_NAME=News2Value API
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=news2value
POSTGRES_PASSWORD=change_me
POSTGRES_DB=news2value
# Порт Postgres из Docker на компьютере. Поменяй (например, на 5433),
# если 5432 занят Postgres, установленной в Windows/macOS
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql://news2value:change_me@db:5432/news2value

# CORS: адреса фронтенда (JSON-список)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Откуда агент берёт новости: mock — agent/data/mock_news.json, db — таблица documents (B4).
# Переключение на db — в модуле B5
NEWS_SOURCE=mock

# ---------- ML: модели (llm/) и агент (agent/) ----------
# Ключ — только здесь, в .env (он в .gitignore). Не коммитить и не вставлять в чаты с ИИ.
# Комментарии — только отдельной строкой: llm/client.py читает значение до конца строки.
LLM_BASE_URL=https://<адрес API из письма организаторов>/v1
LLM_API_KEY=
# id моделей — из чата организаторов 22.10 (те же, что по умолчанию в llm/client.py)
LLM_MODEL_FAST=google/gemma-4-26b-a4b-it
LLM_MODEL_SMART=z-ai/glm-5.3-flash
LLM_MODEL_RESEARCH=deepseek/deepseek-v4.1-flash
# 0, если API не поддерживает response_format
LLM_JSON_MODE=1
# stub — без модели, карточки по правилам; live — вызовы модели с записью в кэш;
# replay — только записанный кэш, ключ не нужен (режим для жюри)
LLM_MODE=stub
# 1 — интерпретация на SMART-модели (включать на финальных прогонах, бережём лимит)
LLM_USE_SMART=0
LLM_DAILY_BUDGET_RUB=500
LLM_PRICE_RUB_PER_1K=0.5
# кто гоняет модель — пишется в лог расхода replay_cache/llm/usage-ДАТА.json
TEAM_MEMBER=
# общий кэш ответов моделей; коммитим — по нему работает replay
LLM_CACHE_DIR=replay_cache/llm
# YYYY-MM-DD; в replay — та же дата, что при записи кэша (от неё зависит отбор новостей)
AGENT_TODAY=
TOP_K_NEWS=5
MIN_RELEVANCE=0.5

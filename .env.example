# Приложение
APP_NAME=News2Value API
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=news2value
POSTGRES_PASSWORD=change_me
POSTGRES_DB=news2value
# Порт Postgres из Docker на компьютере. Поменяй (например, на 5433),
# если 5432 занят Postgres, установленной в Windows/macOS
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql://news2value:change_me@db:5432/news2value

# CORS: адреса фронтенда (JSON-список)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Откуда агент берёт новости: mock — agent/data/mock_news.json, db — таблица documents (B4).
# С ветки feat/llm-fixes-daria db работает и без модели: неразмеченные новости агент размечает
# по словарю (agent/heuristic_extract.py). Для демо — db: у карточек источники из базы и фильтр industry
NEWS_SOURCE=db
# Кто делает инсайты при refresh: real — агент (agent/), fake — заглушка на совпадении слов,
# если agent/ или llm/ сломаны. Не зависит от NEWS_SOURCE и LLM_MODE
ML_MODE=real
# Пауза заглушки (ML_MODE=fake) на каждую карточку, секунды: проверка фоновой работы refresh
FAKE_DELAY_SECONDS=0
# 1 — кэш ответов generate_insight / get_relevant_news в таблице llm_cache (сброс — смена PROMPT_VERSION)
CACHE_ENABLED=0
# worker: задача running дольше стольких минут считается зависшей (worker упал) и получает failed
JOB_TIMEOUT_MINUTES=10
# worker: как часто проверять таблицу jobs, секунды
WORKER_POLL_SECONDS=1
# true — инсайты, дайджест, ask и feedback из моков data/mocks (как до B7): запасной вариант демо
USE_MOCKS=false
# Вход (B8+B9): false — все запросы от пользователя demo (админ, все компании);
# true — нужен токен из POST /auth/login (без токена 401, чужая компания 403)
AUTH_ENABLED=false
# Секрет подписи токенов входа: длинная случайная строка, на сервере — своя.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
# Срок жизни токена входа, минуты
JWT_EXPIRE_MINUTES=720
# Пароль тестовых пользователей (scripts/create_demo_users.py, seed_demo.py), не короче 8 символов
DEMO_USER_PASSWORD=change_me_demo
# Адрес фронтенда на сервере (https://app.example.ru) — добавляется к CORS_ORIGINS
FRONTEND_ORIGIN=

# ---------- Сервер (docker-compose.prod.yml, docs/DEPLOY.md) ----------
# Домен API (api.example.ru) — Caddy сам получит HTTPS-сертификат; пусто — http по IP сервера
DOMAIN=
# Порты Caddy на сервере (поменять, если 80/443 заняты)
HTTP_PORT=80
HTTPS_PORT=443
# Сколько токенов модели можно потратить за сутки по журналу audit_log; 0 — без лимита
LLM_DAILY_TOKEN_LIMIT=0
# ML_MODE=real: таймаут дайджеста и ответа на вопрос, таймаут прогона агента (секунды), повторы
ML_TIMEOUT_SECONDS=60
ML_AGENT_TIMEOUT_SECONDS=300
ML_RETRIES=1

# ---------- ML: модели (llm/) и агент (agent/) ----------
# Ключ — только здесь, в .env (он в .gitignore). Не коммитить и не вставлять в чаты с ИИ.
# Комментарии — только отдельной строкой: llm/client.py читает значение до конца строки.
LLM_BASE_URL=https://<адрес API из письма организаторов>/v1
LLM_API_KEY=
# id моделей — из чата организаторов 22.10 (те же, что по умолчанию в llm/client.py)
LLM_MODEL_FAST=google/gemma-4-26b-a4b-it
LLM_MODEL_SMART=z-ai/glm-5.3-flash
LLM_MODEL_RESEARCH=deepseek/deepseek-v4.1-flash
# 0, если API не поддерживает response_format
LLM_JSON_MODE=1
# stub — без модели, карточки по правилам; live — вызовы модели с записью в кэш;
# replay — только записанный кэш, ключ не нужен (режим для жюри). Чего нет в кэше — карточка по правилам
LLM_MODE=replay
# 1 — интерпретация и критик на SMART-модели (GLM). Кэш для жюри записан с 1 — для replay не менять
LLM_USE_SMART=1
# 1 — второй вызов модели проверяет каждую карточку и при нехватке данных агент ищет ещё
LLM_USE_CRITIC=1
LLM_DAILY_BUDGET_RUB=500
# оценка цены для лимита; по факту 25.10: 0.5 завышало расход примерно в 20 раз (491 ₽ против 23 ₽ по ключу)
LLM_PRICE_RUB_PER_1K=0.025
# кто гоняет модель — пишется в лог расхода replay_cache/llm/usage-ДАТА.json
TEAM_MEMBER=
# общий кэш ответов моделей; коммитим — по нему работает replay
LLM_CACHE_DIR=replay_cache/llm
# «Сегодня» агента, YYYY-MM-DD. От неё считаются даты синтетических новостей и окно поиска,
# поэтому с ней записан кэш для жюри: для replay не менять. Пусто — текущая дата по UTC
AGENT_TODAY=2026-10-25
TOP_K_NEWS=5
MIN_RELEVANCE=0.5
